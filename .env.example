# ============================================================================
# ClinicalRAG — variables d'environnement (exemple)
# ----------------------------------------------------------------------------
# Copiez ce fichier en `.env` et renseignez vos clés :
#     cp .env.example .env
#
# ⚠️  `.env` est ignoré par git (voir .gitignore). Ne committez JAMAIS de clé.
# ============================================================================

# --- Génération (LLM) -----------------------------------------------------
# Fournisseur de génération, interchangeable à chaud (bouton dans l'app) :
#   anthropic : API Anthropic (démo) ; ollama : LLM local (full on-premise).
CLINICALRAG_LLM_PROVIDER=anthropic

# Backend démo : API Anthropic. En production HDS, basculez sur Ollama pour un
# pipeline 100 % local — voir scripts/migrate_to_local.py (rapport de prépa).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLINICALRAG_LLM_MODEL=claude-sonnet-4-6

# Backend local : Ollama. Le modèle doit être récupéré au préalable
# (`ollama pull llama3.2:1b`) et `ollama serve` doit tourner. Le 1B est léger
# (CPU) ; un modèle plus gros (llama3.1:8b) améliore l'ancrage/citation.
CLINICALRAG_OLLAMA_MODEL=llama3.2:1b
CLINICALRAG_OLLAMA_HOST=http://localhost:11434

# --- OCR : MinerU en local (aucune clé) -----------------------------------
# MinerU tourne en local, in-process. Le backend `pipeline` est pur CPU (pas
# de GPU requis) ; `vlm`/`hybrid` nécessitent un GPU. Aucun document ne sort
# de la machine.
CLINICALRAG_MINERU_BACKEND=pipeline
CLINICALRAG_MINERU_PARSE_METHOD=auto    # auto | txt | ocr
CLINICALRAG_MINERU_LANGUAGE=en          # MIMIC-IV : anglais
# Miroir de téléchargement des modèles si le hub par défaut est bloqué :
# CLINICALRAG_MINERU_MODEL_SOURCE=modelscope

# --- Modèles locaux (CPU) -------------------------------------------------
CLINICALRAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
CLINICALRAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# --- Chemins de données ---------------------------------------------------
CLINICALRAG_RAW_DIR=./data/raw
CLINICALRAG_PROCESSED_DIR=./data/processed
CLINICALRAG_CHROMA_DIR=./data/chroma
CLINICALRAG_CHROMA_COLLECTION=clinical_reports

# --- Paramètres de retrieval ----------------------------------------------
CLINICALRAG_TOP_K_VECTOR=20        # candidats issus de la recherche vectorielle
CLINICALRAG_TOP_K_BM25=20          # candidats issus de BM25
CLINICALRAG_RRF_K=60               # constante de la fusion Reciprocal Rank Fusion
CLINICALRAG_TOP_N_RERANK=5         # documents conservés après reranking
